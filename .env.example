# SQLiteデータベースファイルの場所（Docker運用時はホストbind mount先を指す）
# 注意: Prismaの相対パスは prisma/schema.prisma からの相対で解決されるため、
# プロジェクトルート直下の data/ を指すには "../data/..." と書く必要がある
DATABASE_URL="file:../data/home.db"

# セッションJWTの署名鍵。`openssl rand -hex 32` 等で生成したランダム値に変更すること
JWT_SECRET="change-me-to-a-random-32-byte-hex-string"

# SwitchBot Developer API トークン/シークレット
# 取得方法: SwitchBotアプリ > プロフィール > 設定 > アプリバージョンを10回タップ
#          > 開発者向けオプション > Get Token
SWITCHBOT_TOKEN=""
SWITCHBOT_SECRET=""

# 初回起動時、管理者ユーザーが1人も存在しない場合にのみ、この設定で管理者を1人作成する
# （2人目以降のユーザーは管理画面からのみ追加可能）
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="change-me"

# Face ID / パスキー(WebAuthn)用の設定
# WEBAUTHN_RP_ID: アプリにアクセスする際のドメイン名（プロトコル・ポート抜き）
#                 例: 独自ドメイン運用なら "home.example.com"
# WEBAUTHN_ORIGIN: アプリの完全なオリジン（末尾スラッシュなし）
#                 例: "https://home.example.com"
# 注意: この2つはブラウザで実際にアクセスするURLと厳密に一致している必要があり、
#       一致しない場合Face ID登録・ログインが失敗する
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="ホームポータル"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Cloudflare Tunnelのトークン
# 取得方法: Cloudflare Zero Trustダッシュボード > Networks > Tunnels
#          > トンネルを作成 > 表示されるトークンをコピー
CLOUDFLARE_TUNNEL_TOKEN=""
